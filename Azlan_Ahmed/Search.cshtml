@model ANDtr.Web.Features.Search.SearchViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Search Notices";
}

<div class="head">
    <div>
        <h1>Search Safety and Recall Notices</h1>
        <p class="muted small">Search the recall notices by keyword, then narrow the results with filters.</p>
    </div>
</div>

<form class="panel" action="/Search/Results" method="get">
    <div class="searchrow">
        <input type="text" name="keyword" value="@Model.Keyword" aria-label="Keyword" placeholder="Enter a device name, firm, recall number or keyword..." autofocus />
        <button class="btn btn-primary" type="submit">Search</button>
    </div>

    <div class="two opts">
        <div>
            <h3>Search in</h3>
            <label class="check">
                <input type="checkbox" name="searchInDescription" value="true" @(Model.SearchInDescription ? "checked" : "") /> Product description
            </label>
            <label class="check">
                <input type="checkbox" name="searchInTradeName" value="true" @(Model.SearchInTradeName ? "checked" : "") /> Trade name
            </label>
            <label class="check">
                <input type="checkbox" name="searchInFirmName" value="true" @(Model.SearchInFirmName ? "checked" : "") /> Firm name
            </label>
            <label class="check">
                <input type="checkbox" name="searchInRecallReason" value="true" @(Model.SearchInRecallReason ? "checked" : "") /> Recall reason
            </label>
        </div>

        <div>
            <h3>Smarter search <span class="badge b-brand">Optional</span></h3>
            <label class="check">
                <input type="checkbox" name="matchPartialWords" value="true" @(Model.MatchPartialWords ? "checked" : "") /> Match partial words (for example "tracheo" finds tracheostomy)
            </label>
            <label class="check">
                <input type="checkbox" name="includeRelatedTerms" value="true" @(Model.IncludeRelatedTerms ? "checked" : "") /> Include related terms (for example "leak" also finds leakage)
            </label>
        </div>
    </div>
</form>

<div class="two">
    <section class="panel">
        <h2>Recent searches</h2>
        <div class="chips">
            @foreach (var term in Model.RecentKeywords)
            {
                <a class="chip" href="/Search/Results?keyword=@term">@term</a>
            }
        </div>
    </section>

    <section class="panel">
        <h2>Search tips</h2>
        <ul class="plain">
            <li>Searching is not case-sensitive.</li>
            <li>Use a recall number such as <code>Z-1706-2015</code> to find a specific notice directly.</li>
            <li>Use the filters on the results page to narrow by class, firm, product code and classification date.</li>
        </ul>
    </section>
</div>
