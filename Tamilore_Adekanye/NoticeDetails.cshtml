@model ANDtr.Web.Features.Notices.NoticeDetailsViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = $"Notice {Model.Notice.RecallNumber}";
}

<p>
    <a class="back" href="javascript:history.back();">
        <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Results
    </a>
</p>

<div class="head">
    <div>
        <h1>Notice Details</h1>
        <p class="muted small">
            <b>@Model.Notice.RecallNumber</b>
            @if (Model.Notice.RecallClass == "1")
            {
                <span class="badge b-red">Class I</span>
            }
            else if (Model.Notice.RecallClass == "2")
            {
                <span class="badge b-amber">Class II</span>
            }
            else
            {
                <span class="badge b-green">Class III</span>
            }

            @if (Model.Notice.IsTerminated)
            {
                <span class="badge b-grey">Terminated</span>
            }
            else
            {
                <span class="badge b-amber">Ongoing</span>
            }
        </p>
    </div>
</div>

<div class="cols">
    <div>
        <section class="panel">
            <h2>Notice information</h2>
            <table class="kv">
                <tr>
                    <th>Recall number</th>
                    <td class="mono"><b>@Model.Notice.RecallNumber</b></td>
                </tr>
                <tr>
                    <th>Trade name</th>
                    <td>@(string.IsNullOrEmpty(Model.Notice.TradeName) ? "None specified" : Model.Notice.TradeName)</td>
                </tr>
                <tr>
                    <th>Firm name</th>
                    <td><b>@Model.Notice.FirmName</b></td>
                </tr>
                <tr>
                    <th>FEI number</th>
                    <td>@(string.IsNullOrEmpty(Model.Notice.FeiNumber) ? "None specified" : Model.Notice.FeiNumber)</td>
                </tr>
                <tr>
                    <th>Product code</th>
                    <td><b>@Model.Notice.ProductCode</b></td>
                </tr>
                <tr>
                    <th>Product code name</th>
                    <td>@Model.Notice.ProductCodeName</td>
                </tr>
                <tr>
                    <th>Regulation number</th>
                    <td>@Model.Notice.RegulationNumber</td>
                </tr>
                <tr>
                    <th>Classification date</th>
                    <td>@Model.Notice.ClassificationDate.ToString("d MMM yyyy")</td>
                </tr>
                <tr>
                    <th>Posted date</th>
                    <td>@(Model.Notice.PostedDate.HasValue ? Model.Notice.PostedDate.Value.ToString("d MMM yyyy") : "None specified")</td>
                </tr>
                <tr>
                    <th>Termination date</th>
                    <td>@(Model.Notice.TerminationDate.HasValue ? Model.Notice.TerminationDate.Value.ToString("d MMM yyyy") : "Ongoing")</td>
                </tr>
            </table>
        </section>

        <section class="panel">
            <h2>Product description</h2>
            <p style="line-height: 1.6;">@Model.Notice.ProductDescription</p>
        </section>

        <section class="panel">
            <h2>Manufacturer recall reason</h2>
            <p style="line-height: 1.6; color: var(--bad); font-weight: 500;">@Model.Notice.RecallReason</p>
        </section>
    </div>

    <!-- Aside Actions -->
    <aside>
        <section class="panel panel-brand">
            <h2 class="brand-t">Actions</h2>
            <a class="btn btn-primary btn-block" href="/Reviews/Create?noticeIds=@Model.Notice.Id">Add to Risk Review</a>
            <p class="gap">
                <a class="btn btn-outline btn-block" href="@Model.Notice.WebAddress" target="_blank" rel="noopener noreferrer" title="Opens the official FDA record in a new tab">
                    Open FDA Record
                    <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 4h6v6M20 4l-9 9M18 14v5a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V7a1 1 0 0 1 1-1h5"/></svg>
                </a>
            </p>
            <p class="muted xs">The FDA record opens directly on accessdata.fda.gov in a new tab.</p>
        </section>

        <section class="panel">
            <h2>In my reviews</h2>
            @if (Model.AssociatedReviews.Count == 0)
            {
                <p class="muted small">This notice is not in any of your reviews yet.</p>
            }
            else
            {
                <ul class="plain">
                    @foreach (var r in Model.AssociatedReviews)
                    {
                        <li>
                            <a href="/Findings?reviewId=@r.Id"><b>@r.Title</b></a>
                            <small class="muted d-block">Updated @r.UpdatedAt.ToString("d MMM yyyy")</small>
                        </li>
                    }
                </ul>
            }
        </section>
    </aside>
</div>
