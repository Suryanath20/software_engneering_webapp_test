@model ANDtr.Web.Features.Filters.FilterViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Filtered Results & Selection";
    var keyword = Model.Keyword ?? "";
    var queryParams = $"keyword={System.Net.WebUtility.UrlEncode(keyword)}&firmName={System.Net.WebUtility.UrlEncode(Model.FirmName ?? "")}&productCode={System.Net.WebUtility.UrlEncode(Model.ProductCode ?? "")}&sortBy={Model.SortBy}";
    if (Model.Classes != null)
    {
        foreach (var c in Model.Classes) { queryParams += $"&classes={c}"; }
    }
    var baseUrl = $"/Filters?{queryParams}";
}

<div class="head">
    <div>
        <h1>Search Results</h1>
        <p class="muted small">Keyword "@(string.IsNullOrEmpty(keyword) ? "All" : keyword)" with filters applied.</p>
    </div>
</div>

<div class="cols-f">
    <!-- Filter Sidebar -->
    <aside class="panel">
        <h2>Filters</h2>
        <form method="get" action="/Filters" id="filterForm">
            <input type="hidden" name="keyword" value="@Model.Keyword" />

            <h3>Recall class</h3>
            <label class="check">
                <input type="checkbox" name="classes" value="1" @(Model.Classes?.Contains("1") == true ? "checked" : "") />
                Class I <span class="muted">(@Model.Class1TotalCount)</span>
            </label>
            <label class="check">
                <input type="checkbox" name="classes" value="2" @(Model.Classes?.Contains("2") == true ? "checked" : "") />
                Class II <span class="muted">(@Model.Class2TotalCount)</span>
            </label>
            <label class="check">
                <input type="checkbox" name="classes" value="3" @(Model.Classes?.Contains("3") == true ? "checked" : "") />
                Class III <span class="muted">(@Model.Class3TotalCount)</span>
            </label>

            <label for="fFirm">Firm</label>
            <select id="fFirm" name="firmName">
                <option value="">All firms (@Model.AvailableFirms.Count)</option>
                @foreach (var f in Model.AvailableFirms)
                {
                    if (f == Model.FirmName)
                    {
                        <option value="@f" selected>@f</option>
                    }
                    else
                    {
                        <option value="@f">@f</option>
                    }
                }
            </select>

            <label for="fCode">Product code</label>
            <select id="fCode" name="productCode">
                <option value="">All product codes (@Model.AvailableProductCodes.Count)</option>
                @foreach (var p in Model.AvailableProductCodes)
                {
                    if (p == Model.ProductCode)
                    {
                        <option value="@p" selected>@p</option>
                    }
                    else
                    {
                        <option value="@p">@p</option>
                    }
                }
            </select>

            <label for="fFrom">Classified from</label>
            <input id="fFrom" name="fromDate" type="date" value="@(Model.FromDate?.ToString("yyyy-MM-dd"))" />

            <label for="fTo">Classified to</label>
            <input id="fTo" name="toDate" type="date" value="@(Model.ToDate?.ToString("yyyy-MM-dd"))" />

            <label for="fSort">Sort by</label>
            <select id="fSort" name="sortBy">
                <option value="date_desc" selected="@(Model.SortBy == "date_desc")">Date (Newest first)</option>
                <option value="date_asc" selected="@(Model.SortBy == "date_asc")">Date (Oldest first)</option>
                <option value="firm_asc" selected="@(Model.SortBy == "firm_asc")">Firm name (A-Z)</option>
                <option value="class_asc" selected="@(Model.SortBy == "class_asc")">Class (I to III)</option>
            </select>

            <div class="actions col">
                <button class="btn btn-primary btn-block" type="submit">Apply Filters</button>
                <a class="btn btn-outline btn-block" href="/Filters?keyword=@Model.Keyword">Clear Filters</a>
            </div>
        </form>
    </aside>

    <!-- Results Table & Selection Bar -->
    <div>
        <div class="chips">
            @if (!string.IsNullOrEmpty(Model.Keyword))
            {
                <span class="chip">Keyword: @Model.Keyword</span>
            }
            @if (Model.Classes != null)
            {
                foreach (var c in Model.Classes)
                {
                    <span class="chip">Class @(c == "1" ? "I" : c == "2" ? "II" : "III")</span>
                }
            }
            @if (!string.IsNullOrEmpty(Model.FirmName))
            {
                <span class="chip">Firm: @Model.FirmName</span>
            }
            @if (!string.IsNullOrEmpty(Model.ProductCode))
            {
                <span class="chip">Code: @Model.ProductCode</span>
            }
        </div>

        <!-- Persistent Selection Bar -->
        <div class="selbar">
            <b id="selCount">0</b>
            <span>notices selected across pages</span>
            <span class="sp"></span>
            
            <form action="/Reviews/Create" method="get" id="createReviewForm" style="display:inline-flex; gap:8px;">
                <div id="selectedNoticesContainer"></div>
                <button class="btn btn-primary btn-sm js-add-to-review" type="submit">Add to Risk Review</button>
            </form>
            <button class="btn btn-outline btn-sm js-clearsel" type="button">Clear Selection</button>
        </div>

        @if (Model.Results.TotalCount == 0)
        {
            <div class="alert alert-info">
                No recall notices match the chosen filters. Try loosening your criteria or clearing dates.
            </div>
        }
        else
        {
            <div class="tbl-wrap">
                <table class="tbl">
                    <thead>
                        <tr>
                            <th style="width: 36px;">
                                <input id="selAll" type="checkbox" aria-label="Select all on this page" />
                            </th>
                            <th>Recall number</th>
                            <th>Product</th>
                            <th>Firm</th>
                            <th>Class</th>
                            <th>Classified</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var notice in Model.Results.Items)
                        {
                            <tr>
                                <td>
                                    <input class="sel" type="checkbox" data-id="@notice.Id" value="@notice.Id" aria-label="Select @notice.RecallNumber" />
                                </td>
                                <td class="mono">@notice.RecallNumber</td>
                                <td>
                                    <b>@(string.IsNullOrEmpty(notice.TradeName) ? notice.ProductCodeName : notice.TradeName)</b>
                                    <small>@notice.ProductCodeName</small>
                                </td>
                                <td>@notice.FirmName</td>
                                <td>
                                    @if (notice.RecallClass == "1")
                                    {
                                        <span class="badge b-red">Class I</span>
                                    }
                                    else if (notice.RecallClass == "2")
                                    {
                                        <span class="badge b-amber">Class II</span>
                                    }
                                    else
                                    {
                                        <span class="badge b-green">Class III</span>
                                    }
                                </td>
                                <td>@notice.ClassificationDate.ToString("d MMM yyyy")</td>
                                <td>
                                    @if (notice.IsTerminated)
                                    {
                                        <span class="badge b-grey">Terminated</span>
                                    }
                                    else
                                    {
                                        <span class="badge b-amber">Ongoing</span>
                                    }
                                </td>
                                <td>
                                    <a class="btn btn-outline btn-sm" href="/Notices/Details/@notice.Id">View</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <partial name="_Pager" model="(Model.Results.PageNumber, Model.Results.TotalPages, Model.Results.TotalCount, Model.Results.PageSize, baseUrl)" />
        }
    </div>
</div>
