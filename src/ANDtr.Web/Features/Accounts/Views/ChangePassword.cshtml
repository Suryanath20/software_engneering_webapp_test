@model ANDtr.Web.Features.Accounts.ChangePasswordViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Change Temporary Password";
}

<div class="auth">
    <div class="auth-card" style="max-width: 460px;">
        <div class="auth-brand">ANDtr</div>
        <p class="auth-sub">Device Safety &amp; Risk Intelligence</p>
        
        <h1 class="auth-h">Set New Password</h1>
        <p class="muted small" style="margin-bottom: 18px;">
            Your account was created with a temporary password. You must update your password before proceeding to the platform.
        </p>

        <form asp-controller="Accounts" asp-action="ChangePassword" method="post" novalidate>
            <div asp-validation-summary="ModelOnly" class="alert alert-error mb-3" role="alert"></div>

            <div style="margin-bottom: 14px;">
                <label asp-for="CurrentPassword">Current Temporary Password <span class="req">*</span></label>
                <input asp-for="CurrentPassword" type="password" placeholder="Enter temporary password" required autofocus autocomplete="current-password" />
                <span asp-validation-for="CurrentPassword" class="err-t"></span>
            </div>

            <div style="margin-bottom: 14px;">
                <label asp-for="NewPassword">New Password <span class="req">*</span></label>
                <input asp-for="NewPassword" type="password" placeholder="Enter your new secure password" required autocomplete="new-password" />
                <p class="hint">Minimum 8 characters with at least one uppercase letter and one lowercase letter.</p>
                <span asp-validation-for="NewPassword" class="err-t"></span>
            </div>

            <div style="margin-bottom: 20px;">
                <label asp-for="ConfirmNewPassword">Confirm New Password <span class="req">*</span></label>
                <input asp-for="ConfirmNewPassword" type="password" placeholder="Confirm your new password" required autocomplete="new-password" />
                <span asp-validation-for="ConfirmNewPassword" class="err-t"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="padding: 10px 16px; font-weight: 600;">
                Update Password &amp; Continue
            </button>
        </form>
    </div>
</div>
