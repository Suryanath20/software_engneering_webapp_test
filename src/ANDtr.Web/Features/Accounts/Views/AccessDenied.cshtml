@{
    Layout = "_Layout";
    ViewData["Title"] = "Access Denied";
}

<div class="auth" style="min-height: 80vh;">
    <div class="denied">
        <div class="lockc">
            <svg class="ic lg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect x="5" y="11" width="14" height="10" rx="2" />
                <path d="M8 11V7a4 4 0 0 1 8 0v4" />
            </svg>
        </div>
        <h1>Access Denied</h1>
        <p class="muted">
            Your account does not have permission to open this page.<br />
            Customers can only access reviews specifically shared with their organization.
        </p>

        <div class="actions c" style="margin-top: 24px; margin-bottom: 20px;">
            <a class="btn btn-primary" href="/SharedReviews">Go to Shared with Me</a>
            <form asp-controller="Accounts" asp-action="Logout" method="post" class="d-inline">
                <button type="submit" class="btn btn-outline">Sign Out</button>
            </form>
        </div>

        <p class="xs muted">Error 403. If you believe this is a mistake, please contact your ANDtr administrator.</p>
    </div>
</div>
