@model ANDtr.Web.Features.SharedReviews.CustomerCommentsViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Customer Comments";
}

<div class="head">
    <div>
        <h1>Customer Comments</h1>
        <p class="muted small">Comments from customers on the reviews you shared.</p>
    </div>
</div>

<div class="stats three">
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
        </div>
        <b>@Model.TotalCustomerComments</b>
        <span>Total customer comments</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3 2"/>
            </svg>
        </div>
        <b>@Model.AwaitingReplyCount</b>
        <span>Awaiting your reply</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 12h-6l-2 3h-4l-2-3H2"/>
                <path d="M5.5 5h13l3.5 7v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"/>
            </svg>
        </div>
        <b>@Model.ReviewsWithCommentsCount</b>
        <span>Reviews with comments</span>
    </div>
</div>

<div class="chips">
    <a class="chip @(!Model.AwaitingReplyOnly ? "on" : "")" href="/SharedReviews/CustomerComments?awaitingReplyOnly=false">All (@Model.TotalCustomerComments)</a>
    <a class="chip @(Model.AwaitingReplyOnly ? "on" : "")" href="/SharedReviews/CustomerComments?awaitingReplyOnly=true">Awaiting reply (@Model.AwaitingReplyCount)</a>
</div>

@if (Model.GroupedComments.Count == 0)
{
    <div class="panel">
        <div class="empty">
            <b>No customer comments match the filter.</b>
            <span class="muted small">When customers post questions or comments on reviews, they will be listed here.</span>
        </div>
    </div>
}
else
{
    @foreach (var grp in Model.GroupedComments)
    {
        <section class="panel">
            <div style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 12px;">
                <h2 style="margin: 0;">@grp.ReviewTitle</h2>
                <a class="small" href="/Findings?reviewId=@grp.ReviewId">View in Findings &rarr;</a>
            </div>

            @foreach (var c in grp.Comments)
            {
                var isEmp = c.AuthorRole == "Employee";
                var init = !string.IsNullOrEmpty(c.AuthorName) ? c.AuthorName.Substring(0, 1).ToUpper() : "U";
                <div class="cmt">
                    <div class="av @(isEmp ? "av-r" : "av-b")">@init</div>
                    <div class="grow">
                        <div class="meta">
                            <b>@c.AuthorName</b>
                            @if (isEmp)
                            {
                                <span class="badge b-brand">Employee</span>
                            }
                            else
                            {
                                <span class="badge b-grey">Customer</span>
                                @if (!string.IsNullOrEmpty(c.AuthorCompany))
                                {
                                    <small class="muted">@c.AuthorCompany,</small>
                                }
                            }
                            <span class="muted small">@c.CreatedAt.ToString("d MMM yyyy, HH:mm")</span>
                        </div>
                        <p>@c.Body</p>
                    </div>
                </div>
            }

            <!-- Employee Quick Reply Form -->
            <form asp-controller="SharedReviews" asp-action="AddComment" method="post" style="margin-top: 16px;">
                <input type="hidden" name="reviewId" value="@grp.ReviewId" />
                <label for="rep-@grp.ReviewId">Reply</label>
                <textarea id="rep-@grp.ReviewId" name="body" rows="2" placeholder="Write a reply to the customer..." required></textarea>
                <div class="actions">
                    <button class="btn btn-primary btn-sm" type="submit">Post Reply</button>
                </div>
            </form>
        </section>
    }
}
