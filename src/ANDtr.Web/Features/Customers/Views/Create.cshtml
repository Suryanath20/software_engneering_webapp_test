@model ANDtr.Web.Features.Customers.CreateCustomerViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Create Customer Account";
}

<p>
    <a class="back" href="/Customers">
        <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to Customers
    </a>
</p>

<div class="head">
    <div>
        <h1>Create Customer Account</h1>
        <p class="muted small">The customer will use these details to sign in and view the reviews you share.</p>
    </div>
</div>

<div class="cols">
    <section class="panel">
        <form asp-controller="Customers" asp-action="Create" method="post">
            <div style="margin-bottom: 14px;">
                <label asp-for="FullName">Full Name <span class="req">*</span></label>
                <input asp-for="FullName" type="text" placeholder="Enter the customer's full name" required autofocus />
                <span asp-validation-for="FullName" class="err-t"></span>
            </div>

            <div style="margin-bottom: 14px;">
                <label asp-for="Email">Email Address <span class="req">*</span></label>
                <input asp-for="Email" type="email" placeholder="Enter the customer's email address" required />
                <span asp-validation-for="Email" class="err-t"></span>
            </div>

            <div style="margin-bottom: 14px;">
                <label asp-for="Company">Company</label>
                <input asp-for="Company" type="text" placeholder="Enter the customer's organisation" />
            </div>

            <div style="margin-bottom: 14px;">
                <label asp-for="Role">Role <span class="req">*</span></label>
                <select asp-for="Role" id="cRole" style="width: 100%; border: 1px solid #d5d8dd; border-radius: 4px; padding: 9px 12px; font: inherit; font-size: 13.5px; background: #fff;">
                    <option value="Customer" selected>Customer (Hospital Partner)</option>
                    <option value="Employee">Employee (ANDtr Safety Officer)</option>
                </select>
                <span asp-validation-for="Role" class="err-t"></span>
            </div>

            <div style="margin-bottom: 14px;">
                <div style="display:flex; justify-content:space-between; align-items:baseline;">
                    <label asp-for="Password" style="margin:0;">Temporary Password <span class="req">*</span></label>
                    <button type="button" id="btnGenPassword" class="btn btn-outline btn-sm" style="font-size:11px; padding:2px 8px;">Generate Random</button>
                </div>
                <input asp-for="Password" id="cPw" type="text" placeholder="Create a temporary password" required style="margin-top:6px;" />
                <p class="hint">At least 8 characters, with one capital letter, one number and one symbol.</p>
                <span asp-validation-for="Password" class="err-t"></span>
            </div>

            <div style="margin-bottom: 18px;">
                <label asp-for="ConfirmPassword">Confirm Password <span class="req">*</span></label>
                <input asp-for="ConfirmPassword" id="cPw2" type="text" placeholder="Confirm the password" required />
                <span asp-validation-for="ConfirmPassword" class="err-t"></span>
            </div>

            <div class="actions">
                <button class="btn btn-primary" type="submit">Create Account</button>
                <a class="btn btn-outline" href="/Customers">Cancel</a>
            </div>
        </form>
    </section>

    <aside class="panel">
        <h2>Customer permissions</h2>
        <h3>Can</h3>
        <ul class="plain">
            <li>Open reviews shared with them</li>
            <li>Read notices and ANDtr findings</li>
            <li>Add their own comments</li>
        </ul>

        <h3 class="gap">Cannot</h3>
        <ul class="plain">
            <li>Search the full dataset</li>
            <li>Create or edit reviews</li>
            <li>See reviews shared with other customers</li>
        </ul>
    </aside>
</div>
