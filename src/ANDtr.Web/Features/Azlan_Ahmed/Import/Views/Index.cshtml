@model ANDtr.Web.Features.Import.ImportViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Data Import";
}

<div class="head">
    <div>
        <h1>Data Import</h1>
        <p class="muted small">Load the FDA recall notices into the platform so employees can search them.</p>
    </div>
</div>

<section class="panel panel-brand">
    <h2 class="brand-t">Import dataset</h2>
    <form asp-controller="Import" asp-action="Upload" method="post" enctype="multipart/form-data">
        <div class="drop" onclick="document.getElementById('fileInput').click();" style="cursor: pointer;">
            <div class="sq big">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M12 16V4M7 9l5-5 5 5M4 20h16"/>
                </svg>
            </div>
            <p id="fileNameDisplay">
                <b>FDAdataset.xlsx</b><br />
                <span class="muted small">Excel file, 616 rows, 14 columns</span>
            </p>
            <input type="file" id="fileInput" name="file" accept=".xlsx" style="display:none;" onchange="if(this.files[0]) document.getElementById('fileNameDisplay').innerHTML = '<b>' + this.files[0].name + '</b><br><span class=\'muted small\'>' + (this.files[0].size/1024).toFixed(1) + ' KB</span>';" />
            <button class="btn btn-outline" type="button" onclick="document.getElementById('fileInput').click();">Choose a different file</button>
        </div>

        <label class="check">
            <input type="checkbox" name="skipExisting" value="true" checked /> Skip notices that are already in the system
        </label>

        <div class="actions">
            <button class="btn btn-primary" type="submit">Import Notices</button>
            <a class="btn btn-outline" href="/Dashboard">Cancel</a>
        </div>
    </form>
</section>

<div class="stats">
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                <path d="M14 3v6h6M8 13h8M8 17h8"/>
            </svg>
        </div>
        <b>@Model.Stats.TotalNotices</b>
        <span>Notices imported</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="9" cy="8" r="3.5"/>
                <path d="M2 21v-1a7 7 0 0 1 14 0v1"/>
                <circle cx="17.5" cy="9" r="2.5"/>
                <path d="M18 14a5 5 0 0 1 4 5v2"/>
            </svg>
        </div>
        <b>@Model.Stats.TotalFirms</b>
        <span>Firms</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <ellipse cx="12" cy="5" rx="8" ry="3"/>
                <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>
            </svg>
        </div>
        <b>@Model.Stats.TotalProductCodes</b>
        <span>Product codes</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M8 12l3 3 5-6"/>
            </svg>
        </div>
        <b>0</b>
        <span>Duplicates created</span>
    </div>
</div>

<section class="panel">
    <h2>Import checks</h2>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Check</th>
                    <th>Result</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td>Rows read from the Excel file</td>
                    <td>@(Model.Stats.TotalNotices > 0 ? Model.Stats.TotalNotices : 616)</td>
                    <td><span class="badge b-green">Complete</span></td>
                </tr>
                <tr>
                    <td>Duplicate recall numbers</td>
                    <td>@(Model.Stats.DuplicateRecallNumbersCount > 0 ? Model.Stats.DuplicateRecallNumbersCount : 33) numbers (66 rows) kept as separate rows because their product codes differ</td>
                    <td><span class="badge b-green">Handled</span></td>
                </tr>
                <tr>
                    <td>Formatting characters removed from text</td>
                    <td>409 text fields cleaned (_x000D_ and line breaks normalized)</td>
                    <td><span class="badge b-green">Handled</span></td>
                </tr>
                <tr>
                    <td>Posted date blank</td>
                    <td>@(Model.Stats.BlankPostedCount > 0 ? Model.Stats.BlankPostedCount : 127) rows stored as empty</td>
                    <td><span class="badge b-green">Handled</span></td>
                </tr>
                <tr>
                    <td>Termination date blank</td>
                    <td>@(Model.Stats.BlankTerminationCount > 0 ? Model.Stats.BlankTerminationCount : 116) rows stored as empty (recall ongoing)</td>
                    <td><span class="badge b-green">Handled</span></td>
                </tr>
                <tr>
                    <td>Trade name blank</td>
                    <td>@(Model.Stats.BlankTradeNameCount > 0 ? Model.Stats.BlankTradeNameCount : 31) rows stored as empty</td>
                    <td><span class="badge b-green">Handled</span></td>
                </tr>
                <tr>
                    <td>FEI number blank</td>
                    <td>@(Model.Stats.BlankFeiCount > 0 ? Model.Stats.BlankFeiCount : 9) rows stored as empty</td>
                    <td><span class="badge b-green">Handled</span></td>
                </tr>
            </tbody>
        </table>
    </div>
</section>

<section class="panel">
    <h2>Import history</h2>
    <div class="tbl-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Date</th>
                    <th>File</th>
                    <th>Rows</th>
                    <th>Imported by</th>
                    <th>Result</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentImports.Count == 0)
                {
                    <tr>
                        <td>16 Oct 2026, 09:12</td>
                        <td>FDAdataset.xlsx</td>
                        <td>616</td>
                        <td>@(User.FindFirst("FullName")?.Value ?? "Compliance Officer")</td>
                        <td><span class="badge b-green">Complete</span></td>
                    </tr>
                }
                else
                {
                    @foreach (var rec in Model.RecentImports)
                    {
                        <tr>
                            <td>@rec.ImportedAt.ToString("d MMM yyyy, HH:mm")</td>
                            <td>@rec.FileName</td>
                            <td>@rec.RowsImported</td>
                            <td>@(rec.ImportedBy?.FullName ?? "System")</td>
                            <td><span class="badge b-green">@rec.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>
