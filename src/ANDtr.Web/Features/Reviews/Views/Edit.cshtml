@model ANDtr.Web.Features.Reviews.EditReviewViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Edit Risk Review";
}

<p>
    <a class="back" href="/Reviews">
        <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
        Back to My Risk Reviews
    </a>
</p>

<div class="head">
    <div>
        <h1>Edit Risk Review</h1>
        <p class="muted small">Update review details, notes per notice, or remove notices.</p>
    </div>
</div>

<div class="cols">
    <section class="panel">
        <form asp-controller="Reviews" asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />

            <label asp-for="Title">Review Title <span class="req">*</span></label>
            <input asp-for="Title" type="text" required />
            <span asp-validation-for="Title" class="err-t"></span>

            <label asp-for="Description">Description</label>
            <textarea asp-for="Description" rows="4"></textarea>

            <h2 class="gap">Included Notices</h2>
            @if (Model.Notices.Count == 0)
            {
                <div class="empty">
                    <b>No notices attached to this review.</b>
                    <span class="muted small">Browse notices to link them to this review.</span>
                    <a class="btn btn-outline btn-sm" href="/Filters">Browse Notices</a>
                </div>
            }
            else
            {
                <div class="tbl-wrap">
                    <table class="tbl">
                        <thead>
                            <tr>
                                <th>Recall number</th>
                                <th>Product</th>
                                <th>Class</th>
                                <th>Note / Assessment</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var rn in Model.Notices)
                            {
                                <tr>
                                    <td class="mono">
                                        <a href="/Notices/Details/@rn.NoticeId">@rn.Notice.RecallNumber</a>
                                    </td>
                                    <td>
                                        <b>@(string.IsNullOrEmpty(rn.Notice.TradeName) ? rn.Notice.ProductCodeName : rn.Notice.TradeName)</b>
                                    </td>
                                    <td>
                                        @if (rn.Notice.RecallClass == "1")
                                        {
                                            <span class="badge b-red">Class I</span>
                                        }
                                        else if (rn.Notice.RecallClass == "2")
                                        {
                                            <span class="badge b-amber">Class II</span>
                                        }
                                        else
                                        {
                                            <span class="badge b-green">Class III</span>
                                        }
                                    </td>
                                    <td>
                                        <input type="text" name="notes[@rn.NoticeId]" value="@rn.EmployeeNote" placeholder="Add specific risk note..." style="font-size:12.5px; padding:6px 8px;" />
                                    </td>
                                    <td>
                                        <button class="btn btn-danger btn-sm" type="submit" formaction="/Reviews/RemoveNotice?reviewId=@Model.Id&noticeId=@rn.NoticeId" formmethod="post">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <p class="gap">
                <a class="btn btn-outline" href="/Filters">
                    <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    Add More Notices
                </a>
            </p>

            <div class="actions">
                <button class="btn btn-primary" type="submit">Save Changes</button>
                <a class="btn btn-outline" href="/Findings?reviewId=@Model.Id">Open Findings</a>
                <button class="btn btn-danger" type="button" data-open="deleteModal">Delete Review</button>
                <a class="btn btn-outline" href="/Reviews">Cancel</a>
            </div>
        </form>
    </section>

    <aside class="panel">
        <h2>Summary</h2>
        <table class="kv aside-kv">
            <tr>
                <th>Notices</th>
                <td>@Model.Notices.Count</td>
            </tr>
            <tr>
                <th>Class I</th>
                <td>@Model.Class1Count</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>
                    <span class="badge @(Model.Status == "Published" ? "b-green" : "b-grey")">@Model.Status</span>
                </td>
            </tr>
        </table>
        <p class="muted small" style="margin-top: 14px;">
            Changes made here will be reflected across all findings, reports and customer shared views.
        </p>
    </aside>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal-overlay" id="deleteModal" hidden>
    <div class="modal-box">
        <h2 style="color: var(--bad); margin-bottom: 8px;">Delete Risk Review</h2>
        <p>Are you sure you want to permanently delete this risk review? This action cannot be undone.</p>
        <div class="actions right" style="margin-top: 20px;">
            <button class="btn btn-outline btn-sm" type="button" data-close>Cancel</button>
            <form asp-controller="Reviews" asp-action="Delete" asp-route-id="@Model.Id" method="post" style="display:inline;">
                <button class="btn btn-danger btn-sm" type="submit">Delete Permanently</button>
            </form>
        </div>
    </div>
</div>
