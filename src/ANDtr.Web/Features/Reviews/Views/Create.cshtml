@model ANDtr.Web.Features.Reviews.CreateReviewViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Create Risk Review";
}

<div class="head">
    <div>
        <h1>Create a New Risk Review</h1>
        <p class="muted small">Group the notices that matter for one risk review, then save it.</p>
    </div>
</div>

<div class="cols">
    <section class="panel">
        <form asp-controller="Reviews" asp-action="Create" method="post" id="createReviewForm">
            <label asp-for="Title">Review Title <span class="req">*</span></label>
            <input asp-for="Title" type="text" placeholder="Enter a title for this risk review" required autofocus />
            <span asp-validation-for="Title" class="err-t"></span>

            <label asp-for="Description">Description (optional)</label>
            <textarea asp-for="Description" rows="4" placeholder="Enter a description or review scope..."></textarea>

            <h2 class="gap">Selected Notices</h2>
            @if (Model.SelectedNotices.Count == 0)
            {
                <div class="empty" style="margin-bottom: 16px;">
                    <b>No notices selected yet.</b>
                    <span class="muted small">Select notices from Search or Filters to add them to this review.</span>
                    <a class="btn btn-outline btn-sm" href="/Filters">Browse & Select Notices</a>
                </div>
            }
            else
            {
                <div class="tbl-wrap">
                    <table class="tbl" id="selectedNoticesTable">
                        <thead>
                            <tr>
                                <th>Recall number</th>
                                <th>Product</th>
                                <th>Firm</th>
                                <th>Class</th>
                                <th>Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @for (int i = 0; i < Model.SelectedNotices.Count; i++)
                            {
                                var n = Model.SelectedNotices[i];
                                <tr id="notice-row-@n.Id">
                                    <td class="mono">
                                        @n.RecallNumber
                                        <input type="hidden" name="NoticeIds" value="@n.Id" />
                                    </td>
                                    <td>
                                        <b>@(string.IsNullOrEmpty(n.TradeName) ? n.ProductCodeName : n.TradeName)</b>
                                    </td>
                                    <td>@n.FirmName</td>
                                    <td>
                                        @if (n.RecallClass == "1")
                                        {
                                            <span class="badge b-red">Class I</span>
                                        }
                                        else if (n.RecallClass == "2")
                                        {
                                            <span class="badge b-amber">Class II</span>
                                        }
                                        else
                                        {
                                            <span class="badge b-green">Class III</span>
                                        }
                                    </td>
                                    <td>
                                        <button class="btn btn-danger btn-sm" type="button" onclick="document.getElementById('notice-row-@n.Id').remove();">Remove</button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

            <p class="gap">
                <a class="btn btn-outline" href="/Filters">
                    <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                    Add More Notices
                </a>
            </p>

            <div class="actions">
                <button class="btn btn-primary" type="submit">Save Review</button>
                <a class="btn btn-outline" href="/Reviews">Cancel</a>
            </div>
        </form>
    </section>

    <aside class="panel">
        <h2>Summary</h2>
        <table class="kv aside-kv">
            <tr>
                <th>Notices</th>
                <td>@Model.SelectedNotices.Count</td>
            </tr>
            <tr>
                <th>Class I</th>
                <td>@Model.Class1Count</td>
            </tr>
            <tr>
                <th>Owner</th>
                <td>@(User.Identity?.Name ?? "Employee")</td>
            </tr>
        </table>
        <p class="muted small" style="margin-top: 14px;">
            Notices you select on the search results page appear here. You can remove a notice before saving.
        </p>
    </aside>
</div>
