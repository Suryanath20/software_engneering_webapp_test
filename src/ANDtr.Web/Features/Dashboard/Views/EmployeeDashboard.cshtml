@model ANDtr.Web.Features.Dashboard.EmployeeDashboardViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Employee Dashboard";
}

@{
    var userFullName = User.FindFirst("FullName")?.Value;
    if (string.IsNullOrWhiteSpace(userFullName))
    {
        userFullName = Model.EmployeeName;
    }
    var userRole = User.FindFirst("RoleLabel")?.Value ?? (User.IsInRole("Employee") ? "Employee" : "Customer");
}

<div class="head">
    <div>
        <h1 style="display:flex; align-items:center; gap:10px;">
            Welcome, @userFullName
            <span class="badge b-brand" style="font-size:13px; font-weight:600; padding:3px 9px;">@userRole</span>
        </h1>
        <p class="muted small">Medical Device Safety and Recall Operations</p>
    </div>
</div>

<div class="stats">
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <ellipse cx="12" cy="5" rx="8" ry="3"/>
                <path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/>
            </svg>
        </div>
        <b>@Model.TotalNotices</b>
        <span>Notices in dataset</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3l10 18H2z"/>
                <path d="M12 10v5M12 18h.01"/>
            </svg>
        </div>
        <b>@Model.Class1Count</b>
        <span>Class I recalls</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/>
                <path d="M14 3v6h6M8 13h8M8 17h8"/>
            </svg>
        </div>
        <b>@Model.MyReviewsCount</b>
        <span>My risk reviews</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="18" cy="5" r="3"/>
                <circle cx="6" cy="12" r="3"/>
                <circle cx="18" cy="19" r="3"/>
                <path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/>
            </svg>
        </div>
        <b>@Model.SharedReviewsCount</b>
        <span>Reviews shared with customers</span>
    </div>
</div>

<section class="panel panel-brand">
    <h2 class="brand-t">Risk review workflow</h2>
    <p class="muted small">Find, review, organise and share relevant safety and recall information.</p>
    <div class="steps">
        <a class="step" href="/Search">
            <div class="n">1</div>
            <h3>Search notices</h3>
            <p class="muted small">Find recall notices by keyword and filters.</p>
        </a>
        <a class="step" href="/Filters">
            <div class="n">2</div>
            <h3>Select and review</h3>
            <p class="muted small">Pick the notices that matter to a risk review.</p>
        </a>
        <a class="step" href="/Reviews">
            <div class="n">3</div>
            <h3>Add findings</h3>
            <p class="muted small">Record your comments and assessment.</p>
        </a>
        <a class="step" href="/Sharing">
            <div class="n">4</div>
            <h3>Share with customer</h3>
            <p class="muted small">Give a customer access to the review.</p>
        </a>
    </div>
    <a class="btn btn-primary" href="/Reviews/Create">
        <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 5v14M5 12h14"/>
        </svg> Create Risk Review
    </a>
</section>

<div class="two">
    <section class="panel">
        <h2>Recent Activity</h2>
        <ul class="list">
            @foreach (var act in Model.RecentActivities)
            {
                <li>
                    <div class="dot">
                        @if (act.IconType == "comment")
                        {
                            <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        }
                        else if (act.IconType == "share")
                        {
                            <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
                        }
                        else if (act.IconType == "import")
                        {
                            <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><ellipse cx="12" cy="5" rx="8" ry="3"/><path d="M4 5v6c0 1.7 3.6 3 8 3s8-1.3 8-3V5M4 11v6c0 1.7 3.6 3 8 3s8-1.3 8-3v-6"/></svg>
                        }
                        else
                        {
                            <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h8"/></svg>
                        }
                    </div>
                    <div>
                        @act.Title
                        <small>@act.TimeAgo</small>
                    </div>
                </li>
            }
        </ul>
    </section>

    <section class="panel">
        <h2>Quick Actions</h2>
        <div class="qa">
            <a href="/Search">
                <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                Search notices
                <svg class="ic sm chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
            <a href="/Reviews/Create">
                <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                Create a risk review
                <svg class="ic sm chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
            <a href="/Sharing">
                <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
                Share a review
                <svg class="ic sm chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
            <a href="/Reports">
                <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h16M7 20v-7M12 20V6M17 20v-10"/></svg>
                Generate a report
                <svg class="ic sm chev" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 6l6 6-6 6"/></svg>
            </a>
        </div>
    </section>
</div>
