@model ANDtr.Web.Features.Dashboard.CustomerDashboardViewModel
@{
    Layout = "_CustomerLayout";
    ViewData["Title"] = "Customer Dashboard";
}

@{
    var userFullName = User.FindFirst("FullName")?.Value;
    if (string.IsNullOrWhiteSpace(userFullName))
    {
        userFullName = Model.CustomerName;
    }
    var userRole = User.FindFirst("RoleLabel")?.Value ?? (User.IsInRole("Employee") ? "Employee" : "Customer");
}

<div class="head">
    <div>
        <h1 style="display:flex; align-items:center; gap:10px;">
            Welcome, @userFullName
            <span class="badge b-green" style="font-size:13px; font-weight:600; padding:3px 9px;">@userRole</span>
        </h1>
        <p class="muted small">@Model.CompanyName &bull; Authorized Safety Reviews</p>
    </div>
</div>

<div class="stats three">
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M22 12h-6l-2 3h-4l-2-3H2"/>
                <path d="M5.5 5h13l3.5 7v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"/>
            </svg>
        </div>
        <b>@Model.SharedReviewsCount</b>
        <span>Reviews shared with you</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="9"/>
                <path d="M12 7v5l3 2"/>
            </svg>
        </div>
        <b>@Model.NewSinceLastVisitCount</b>
        <span>New since your last visit</span>
    </div>
    <div class="stat">
        <div class="sq">
            <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
            </svg>
        </div>
        <b>@Model.CustomerCommentsCount</b>
        <span>Your comments</span>
    </div>
</div>

<section class="panel panel-brand">
    <h2 class="brand-t">Shared with you</h2>
    <p class="muted small">Reviews that ANDtr has shared with your organisation.</p>

    @if (Model.SharedReviews.Count == 0)
    {
        <div class="empty">
            <b>No reviews have been shared with you yet.</b>
            <span class="muted small">When ANDtr shares a review, it will appear here.</span>
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Review title</th>
                        <th>Date shared</th>
                        <th>Notices</th>
                        <th>Status</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var rev in Model.SharedReviews)
                    {
                        <tr>
                            <td><b>@rev.ReviewTitle</b></td>
                            <td>@rev.SharedAt.ToString("d MMM yyyy")</td>
                            <td>@rev.NoticeCount</td>
                            <td>
                                @if (rev.Status == "New")
                                {
                                    <span class="badge b-brand">New</span>
                                }
                                else
                                {
                                    <span class="badge b-grey">Viewed</span>
                                }
                            </td>
                            <td>
                                <a class="btn btn-primary btn-sm" href="/SharedReviews/Details/@rev.ReviewId">Open</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>

<section class="panel">
    <h2>What you can do here</h2>
    <ul class="plain">
        <li>Read the reviews that ANDtr has shared with you, including each notice and the employee findings.</li>
        <li>Add your own comments to a shared review.</li>
        <li>You cannot search the full dataset or change ANDtr's findings.</li>
    </ul>
</section>
