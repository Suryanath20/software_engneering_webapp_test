@model ANDtr.Web.Features.Customers.CustomerListViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Customers & Users";
}

<div class="head">
    <div>
        <h1>Customer &amp; User Accounts</h1>
        <p class="muted small">Provision and manage internal employees and hospital customer accounts.</p>
    </div>
</div>

<!-- Employee-Only Add User Form Panel -->
<div class="panel" style="margin-bottom: 24px; border: 1px solid var(--line); border-radius: 6px; padding: 20px; background: #fff;">
    <div style="margin-bottom: 14px;">
        <h2 style="font-size: 16px; margin: 0; display:flex; align-items:center; gap:8px;">
            <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/><line x1="20" y1="8" x2="20" y2="14"/><line x1="23" y1="11" x2="17" y2="11"/></svg>
            Add User Account
        </h2>
        <p class="muted small" style="margin: 4px 0 0;">Provision an Employee or Customer account with temporary credentials and forced first-login password change.</p>
    </div>

    <form asp-controller="Customers" asp-action="Create" method="post" id="addUserForm" novalidate>
        <input type="hidden" name="returnView" value="Index" />
        <div asp-validation-summary="ModelOnly" class="alert alert-error" role="alert"></div>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 14px; margin-bottom: 14px;">
            <div>
                <label asp-for="NewUser.FullName">Full Name <span class="req">*</span></label>
                <input asp-for="NewUser.FullName" name="FullName" placeholder="e.g. Dr. Jordan Smith" required />
                <span asp-validation-for="NewUser.FullName" class="err-t"></span>
            </div>

            <div>
                <label asp-for="NewUser.Email">Email Address <span class="req">*</span></label>
                <input asp-for="NewUser.Email" name="Email" type="email" placeholder="e.g. jsmith@hospital.org" required />
                <span asp-validation-for="NewUser.Email" class="err-t"></span>
            </div>

            <div>
                <label asp-for="NewUser.Role">Account Role <span class="req">*</span></label>
                <select asp-for="NewUser.Role" name="Role" style="width: 100%; border: 1px solid #d5d8dd; border-radius: 4px; padding: 9px 12px; font: inherit; font-size: 13.5px; background: #fff;">
                    <option value="Customer">Customer (Hospital Partner)</option>
                    <option value="Employee">Employee (ANDtr Safety Officer)</option>
                </select>
                <span asp-validation-for="NewUser.Role" class="err-t"></span>
            </div>

            <div>
                <label asp-for="NewUser.Company">Company / Organization</label>
                <input asp-for="NewUser.Company" name="Company" placeholder="e.g. Northfield Medical Group" />
            </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-bottom: 14px;">
            <div>
                <div style="display:flex; justify-content:space-between; align-items:baseline;">
                    <label asp-for="NewUser.Password" style="margin:0;">Temporary Password <span class="req">*</span></label>
                    <button type="button" id="btnGenPasswordInline" class="btn btn-outline btn-sm" style="font-size:11px; padding:2px 8px;">Generate Random</button>
                </div>
                <input asp-for="NewUser.Password" name="Password" id="inlinePw" type="text" placeholder="Temporary password" required style="margin-top:6px;" />
                <span asp-validation-for="NewUser.Password" class="err-t"></span>
            </div>

            <div>
                <label asp-for="NewUser.ConfirmPassword">Confirm Password <span class="req">*</span></label>
                <input asp-for="NewUser.ConfirmPassword" name="ConfirmPassword" id="inlinePw2" type="text" placeholder="Confirm password" required />
                <span asp-validation-for="NewUser.ConfirmPassword" class="err-t"></span>
            </div>
        </div>

        <div style="margin-bottom: 18px;">
            <label class="check" style="cursor:pointer; display:flex; align-items:center; gap:8px; font-weight:normal;">
                <input asp-for="NewUser.MustChangePassword" name="MustChangePassword" type="checkbox" value="true" style="width:auto; margin:0;" checked />
                <span><b>Must change password at first login</b> (forces password update on initial sign-in)</span>
            </label>
        </div>

        <div>
            <button class="btn btn-primary" type="submit">Create User Account</button>
        </div>
    </form>
</div>

<!-- Customers & Users Table -->
<form method="get" action="/Customers" class="toolrow">
    <input type="text" name="search" value="@Model.Search" placeholder="Search accounts by name, email or company..." aria-label="Search accounts" />
</form>

@if (Model.Customers.Count == 0)
{
    <div class="panel">
        <div class="empty">
            <b>No customer accounts found.</b>
            <span class="muted small">Use the form above to add your first user account.</span>
        </div>
    </div>
}
else
{
    <div class="tbl-wrap">
        <table class="tbl">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Company</th>
                    <th>Created</th>
                    <th>Reviews shared</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model.Customers)
                {
                    <tr>
                        <td><b>@c.FullName</b></td>
                        <td>@c.Email</td>
                        <td>@(string.IsNullOrEmpty(c.CompanyName) ? "—" : c.CompanyName)</td>
                        <td>@c.CreatedAt.ToString("d MMM yyyy")</td>
                        <td>@c.ReviewsSharedCount</td>
                        <td>
                            @if (c.IsActive)
                            {
                                <span class="badge b-green">Active</span>
                            }
                            else
                            {
                                <span class="badge b-red">Inactive</span>
                            }
                        </td>
                        <td>
                            <div style="display:flex; gap:6px;">
                                <a class="btn btn-outline btn-sm" href="/Sharing?customerId=@c.Id">Share Review</a>
                                <form asp-controller="Customers" asp-action="ToggleActive" method="post" style="display:inline;">
                                    <input type="hidden" name="customerId" value="@c.Id" />
                                    @if (c.IsActive)
                                    {
                                        <button type="submit" class="btn btn-outline btn-sm btn-danger">Deactivate</button>
                                    }
                                    else
                                    {
                                        <button type="submit" class="btn btn-outline btn-sm">Activate</button>
                                    }
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function () {
    var genBtn = document.getElementById("btnGenPasswordInline");
    if (genBtn) {
        genBtn.addEventListener("click", function () {
            var chars = "ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnpqrstuvwxyz23456789!@@#$%";
            var pw = "";
            for (var i = 0; i < 10; i++) {
                pw += chars.charAt(Math.floor(Math.random() * chars.length));
            }
            var p1 = document.getElementById("inlinePw");
            var p2 = document.getElementById("inlinePw2");
            if (p1) p1.value = pw;
            if (p2) p2.value = pw;
        });
    }
});
</script>
}
