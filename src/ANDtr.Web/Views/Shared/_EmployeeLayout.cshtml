@{
    Layout = "_Layout";
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
    var userFullName = User.Identity?.Name ?? "Employee";
    var userInitial = userFullName.Length > 0 ? userFullName.Substring(0, 1).ToUpper() : "E";
}

<div class="app">
    <!-- Sidebar Navigation -->
    <aside class="side" aria-label="Sidebar Navigation">
        <div class="brandbar">
            <b>ANDtr</b>
            <span>Device Safety<br />Platform</span>
        </div>
        <nav class="nav" aria-label="Main menu">
            <a href="/Dashboard" class="@(currentController == "Dashboard" ? "on" : "")">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11l9-8 9 8v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1z"/></svg>
                <span>Dashboard</span>
            </a>
            <a href="/Search" class="@(currentController == "Search" || currentController == "Filters" ? "on" : "")">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <span>Search Notices</span>
            </a>
            <a href="/Reviews" class="@(currentController == "Reviews" && currentAction != "Create" ? "on" : "")">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9z"/><path d="M14 3v6h6M8 13h8M8 17h8"/></svg>
                <span>My Risk Reviews</span>
            </a>
            <a href="/Reviews/Create" class="@(currentController == "Reviews" && currentAction == "Create" ? "on" : "")">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 5v14M5 12h14"/></svg>
                <span>Create Review</span>
            </a>
            <a href="/Sharing" class="@(currentController == "Sharing" ? "on" : "")">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><path d="M8.6 13.5l6.8 4M15.4 6.5l-6.8 4"/></svg>
                <span>Sharing</span>
            </a>
            <a href="/Customers" class="@(currentController == "Customers" ? "on" : "")">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="3.5"/><path d="M2 21v-1a7 7 0 0 1 14 0v1"/><circle cx="17.5" cy="9" r="2.5"/><path d="M18 14a5 5 0 0 1 4 5v2"/></svg>
                <span>Customers</span>
            </a>
            <a href="/Reports" class="@(currentController == "Reports" ? "on" : "")">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 20h16M7 20v-7M12 20V6M17 20v-10"/></svg>
                <span>Reports</span>
            </a>
            <a href="/Import" class="@(currentController == "Import" ? "on" : "")">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 16V4M7 9l5-5 5 5M4 20h16"/></svg>
                <span>Data Import</span>
            </a>
        </nav>
        <div class="userbox">
            <div class="who">
                <div class="avatar">@userInitial</div>
                <div>
                    <b>@userFullName</b>
                    <small>Employee</small>
                </div>
            </div>
            <form asp-controller="Accounts" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn btn-outline btn-block btn-sm">Sign Out</button>
            </form>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main">
        <header class="top">
            <form action="/Search/Results" method="get" class="search" role="search">
                <svg class="ic sm" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.3-4.3"/></svg>
                <input type="text" name="keyword" placeholder="Search notices, firms, recall numbers..." aria-label="Search notices" />
            </form>
            <a href="/SharedReviews/CustomerComments" class="bell" title="Customer Comments" aria-label="Customer comments notification">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 9h18c0-1-3-2-3-9M10 21a2 2 0 0 0 4 0"/></svg>
                <i>2</i>
            </a>
        </header>
        <main class="content" id="main-content">
            <partial name="_Validation" />
            @RenderBody()
        </main>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)
