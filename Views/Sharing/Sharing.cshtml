@model ANDtr.Web.Features.Sharing.ShareViewModel
@{
    Layout = "_EmployeeLayout";
    ViewData["Title"] = "Share Risk Review";
}

<div class="head">
    <div>
        <h1>Share Risk Review with Customer</h1>
        <p class="muted small">Choose a review and a customer. The customer will only see the reviews you share with them.</p>
    </div>
</div>

<div class="cols">
    <section class="panel">
        <form asp-controller="Sharing" asp-action="Share" method="post" id="shareForm">
            <label for="shareReview">Review <span class="req">*</span></label>
            <select id="shareReview" name="reviewId" onchange="window.location.href='/Sharing?reviewId=' + this.value;">
                @foreach (var r in Model.AvailableReviews)
                {
                    if (r.Id == Model.SelectedReviewId)
                    {
                        <option value="@r.Id" selected>@r.Title</option>
                    }
                    else
                    {
                        <option value="@r.Id">@r.Title</option>
                    }
                }
            </select>

            <label for="shareCustomer">Select Customer <span class="req">*</span></label>
            <select id="shareCustomer" name="customerId" required>
                <option value="">Search or select a customer...</option>
                @foreach (var c in Model.AvailableCustomers)
                {
                    <option value="@c.Id">@c.FullName, @c.CompanyName</option>
                }
            </select>

            <label for="shareMsg">Message (optional)</label>
            <textarea id="shareMsg" name="message" rows="4" placeholder="Enter a message to the customer..."></textarea>

            <div class="actions">
                <button class="btn btn-primary" type="submit">Share with Customer</button>
                <a class="btn btn-outline" href="/Dashboard">Cancel</a>
            </div>
        </form>
    </section>

    <aside class="panel">
        <h2>Selected review</h2>
        @if (Model.SelectedReview != null)
        {
            var activeShareCount = Model.SelectedReview.Shares.Count(s => s.RevokedAt == null);
            <table class="kv aside-kv">
                <tr>
                    <th>Title</th>
                    <td><b>@Model.SelectedReview.Title</b></td>
                </tr>
                <tr>
                    <th>Notices</th>
                    <td>@Model.SelectedReview.ReviewNotices.Count</td>
                </tr>
                <tr>
                    <th>Created</th>
                    <td>@Model.SelectedReview.CreatedAt.ToString("d MMM yyyy")</td>
                </tr>
                <tr>
                    <th>Sharing</th>
                    <td>
                        @if (activeShareCount > 0)
                        {
                            <span class="badge b-green">Shared with @activeShareCount</span>
                        }
                        else
                        {
                            <span class="badge b-grey">Not shared</span>
                        }
                    </td>
                </tr>
            </table>
        }
        else
        {
            <p class="muted small">Select a review from the dropdown to see its details.</p>
        }
    </aside>
</div>

<section class="panel">
    <h2>Currently shared with</h2>
    @if (Model.CurrentShares.Count == 0)
    {
        <div class="empty">
            <b>No active shares for this review.</b>
            <span class="muted small">Select a customer above to share this review.</span>
        </div>
    }
    else
    {
        <div class="tbl-wrap">
            <table class="tbl">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Company</th>
                        <th>Date shared</th>
                        <th>Access</th>
                        <th>Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var share in Model.CurrentShares)
                    {
                        <tr>
                            <td><b>@share.CustomerName</b></td>
                            <td>@share.CustomerCompany</td>
                            <td>@share.SharedAt.ToString("d MMM yyyy")</td>
                            <td class="st">
                                @if (share.IsActive)
                                {
                                    <span class="badge b-green">Can view and comment</span>
                                }
                                else
                                {
                                    <span class="badge b-grey">Sharing stopped</span>
                                }
                            </td>
                            <td>
                                @if (share.IsActive)
                                {
                                    <form asp-controller="Sharing" asp-action="StopSharing" method="post" style="display:inline;">
                                        <input type="hidden" name="shareId" value="@share.ShareId" />
                                        <input type="hidden" name="reviewId" value="@Model.SelectedReviewId" />
                                        <button class="btn btn-danger btn-sm" type="submit">Stop sharing</button>
                                    </form>
                                }
                                else
                                {
                                    <button class="btn btn-outline btn-sm" disabled>Stopped</button>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</section>
