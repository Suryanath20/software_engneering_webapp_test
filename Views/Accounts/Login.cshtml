@model ANDtr.Web.Features.Accounts.LoginViewModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Sign In";
}

<div class="auth">
    <div class="authbox">
        <div class="brandlogo">
            <b>ANDtr</b>
            <span>Medical Device Safety & Recall Platform</span>
        </div>

        <h1 class="center" style="font-size: 20px; margin-bottom: 4px;">Sign in to your account</h1>
        <p class="muted small center" style="margin-bottom: 24px;">Enter your credentials to access the safety platform.</p>

        <partial name="_Validation" />

        <form asp-controller="Accounts" asp-action="Login" method="post" id="loginForm">
            <input type="hidden" asp-for="ReturnUrl" />

            <div style="margin-bottom: 16px;">
                <label asp-for="Email">Email Address <span class="req">*</span></label>
                <input asp-for="Email" type="email" placeholder="name@company.com" autocomplete="email" required autofocus />
                <span asp-validation-for="Email" class="err-t"></span>
            </div>

            <div style="margin-bottom: 16px;">
                <label asp-for="Password">Password <span class="req">*</span></label>
                <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" required />
                <span asp-validation-for="Password" class="err-t"></span>
            </div>

            <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 22px;">
                <label class="check m-0">
                    <input asp-for="RememberMe" type="checkbox" /> Remember me
                </label>
                <span class="xs muted">5 attempts before lockout</span>
            </div>

            <button type="submit" class="btn btn-primary btn-block" style="padding: 10px 16px; font-weight: 600;">
                Sign In
            </button>
        </form>

        <hr />

        <p class="center muted small" style="text-align: center; margin: 14px 0 0; font-size: 12px;">
            Accounts are provisioned by ANDtr. Contact your system administrator to request access.
        </p>
    </div>
</div>
