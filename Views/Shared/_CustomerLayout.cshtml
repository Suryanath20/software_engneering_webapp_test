@{
    Layout = "_Layout";
    var userFullName = User.FindFirst("FullName")?.Value;
    if (string.IsNullOrWhiteSpace(userFullName))
    {
        userFullName = User.Identity?.Name ?? "Customer";
    }
    var userRole = User.FindFirst("RoleLabel")?.Value ?? (User.IsInRole("Employee") ? "Employee" : "Customer");
    var userInitial = userFullName.Length > 0 ? userFullName.Substring(0, 1).ToUpper() : "C";
    var companyName = User.FindFirst("CompanyName")?.Value ?? "Medical Partner";
}

<div class="app">
    <!-- Customer Sidebar Navigation -->
    <aside class="side" aria-label="Customer Sidebar Navigation">
        <div class="brandbar">
            <b>ANDtr</b>
            <span>Device Safety<br />Platform</span>
        </div>
        <nav class="nav" aria-label="Main menu">
            <a href="/SharedReviews" class="on">
                <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.5 5h13l3.5 7v6a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2v-6z"/></svg>
                <span>Shared with Me</span>
            </a>
        </nav>
        <div class="userbox">
            <div class="who">
                <div class="avatar av-cust">@userInitial</div>
                <div>
                    <b>@userFullName</b>
                    <span class="badge b-green" style="font-size:10.5px; padding:1px 6px; margin-top:2px; display:inline-block;">@userRole</span>
                </div>
            </div>
            <form asp-controller="Accounts" asp-action="Logout" method="post" class="m-0">
                <button type="submit" class="btn btn-outline btn-block btn-sm">Sign Out</button>
            </form>
        </div>
    </aside>

    <!-- Main Content Area -->
    <div class="main">
        <header class="top" style="display:flex; justify-content:space-between; align-items:center;">
            <div class="portal">
                Customer portal <span>@companyName</span>
            </div>
            <div style="display:flex; align-items:center; gap:16px;">
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="font-size:13px; font-weight:600; color:var(--ink);">Welcome, @userFullName</span>
                    <span class="badge b-green">@userRole</span>
                </div>
                <!-- Interactive Customer Notification Bell -->
                <div style="position:relative;">
                    <button class="bell" id="custNotifBell" type="button" aria-label="Notifications" onclick="toggleCustomerNotifs(event)">
                        <svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M18 8a6 6 0 0 0-12 0c0 7-3 8-3 9h18c0-1-3-2-3-9M10 21a2 2 0 0 0 4 0"/></svg>
                        <i id="custNotifBadge">1</i>
                    </button>
                    <div id="custNotifDropdown" class="notif-dropdown" style="display:none; position:absolute; right:0; top:44px; width:330px; background:#ffffff; border:1px solid #e5e7eb; border-radius:10px; box-shadow:0 10px 25px rgba(0,0,0,0.12); z-index:1000; overflow:hidden;">
                        <div style="padding:12px 16px; background:#f9fafb; border-bottom:1px solid #e5e7eb; display:flex; justify-content:space-between; align-items:center;">
                            <b style="font-size:13.5px; color:#111827;">Notifications</b>
                            <span id="custNotifPill" style="font-size:11px; font-weight:600; background:#e0f2fe; color:#0369a1; padding:2px 7px; border-radius:999px;">1 New</span>
                        </div>
                        <div style="max-height:280px; overflow-y:auto;">
                            <a href="/SharedReviews" style="display:block; padding:12px 16px; text-decoration:none; border-bottom:1px solid #f3f4f6; transition:background 0.15s;" onmouseover="this.style.background='#f9fafb'" onmouseout="this.style.background='#fff'">
                                <div style="display:flex; gap:10px; align-items:flex-start;">
                                    <div style="width:32px; height:32px; border-radius:50%; background:#fef2f2; color:#c8102e; display:grid; place-items:center; flex-shrink:0;">
                                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                                    </div>
                                    <div style="flex:1;">
                                        <div style="font-size:13px; font-weight:600; color:#111827;">New Safety Review Shared</div>
                                        <div style="font-size:12px; color:#4b5563; margin-top:2px;">ANDtr Risk Team shared <b>Anesthesia gas machine leak review</b> with your facility.</div>
                                        <div style="font-size:11px; color:#c8102e; font-weight:600; margin-top:5px;">Open review &rarr;</div>
                                    </div>
                                </div>
                            </a>
                        </div>
                        <div style="padding:9px 16px; background:#f9fafb; display:flex; justify-content:space-between; align-items:center;">
                            <a href="/SharedReviews" style="font-size:12px; font-weight:600; color:#c8102e; text-decoration:none;">View All Shared</a>
                            <button type="button" onclick="markCustomerNotifsRead(event)" style="background:none; border:none; font-size:11px; color:#6b7280; cursor:pointer; text-decoration:underline;">Mark as read</button>
                        </div>
                    </div>
                </div>
            </div>
        </header>
        <main class="content" id="main-content">
            <partial name="_Validation" />
            @RenderBody()
        </main>
    </div>
</div>

@await RenderSectionAsync("Scripts", required: false)

<script>
    function toggleCustomerNotifs(e) {
        if (e) e.stopPropagation();
        var dd = document.getElementById('custNotifDropdown');
        if (dd) {
            dd.style.display = (dd.style.display === 'none' || dd.style.display === '') ? 'block' : 'none';
        }
    }
    function markCustomerNotifsRead(e) {
        if (e) {
            e.preventDefault();
            e.stopPropagation();
        }
        var badge = document.getElementById('custNotifBadge');
        var pill = document.getElementById('custNotifPill');
        if (badge) badge.style.display = 'none';
        if (pill) {
            pill.textContent = '0 New';
            pill.style.background = '#f3f4f6';
            pill.style.color = '#6b7280';
        }
    }
    document.addEventListener('click', function(e) {
        var dd = document.getElementById('custNotifDropdown');
        var bell = document.getElementById('custNotifBell');
        if (dd && bell && !bell.contains(e.target) && !dd.contains(e.target)) {
            dd.style.display = 'none';
        }
    });
</script>
